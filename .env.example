# ─── Docker MariaDB credentials (local-db profile only) ─────────────────────
# Not used by the production API container. See docs/podman-migration.md.
# Host port for that optional database is 127.0.0.1:3307.
DB_NAME=muhanmantle
DB_USER=muhanmantle
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# ─── Database ───────────────────────────────────────────────────────────────
# SQLAlchemy URL. Use mysql+pymysql:// prefix for MariaDB/MySQL.
# If you still have the old django-environ format (mysql://...) it is
# auto-converted at startup.
# Production container uses host networking, so 127.0.0.1 is the host MariaDB.
# Laptop local-db profile listens on 127.0.0.1:3307 instead of 3306.
DATABASE_URL=mysql+pymysql://muhanmantle:change-me@127.0.0.1:3306/muhanmantle

# ─── Container bind (host network) ──────────────────────────────────────────
# Keep 127.0.0.1 so host Nginx is the only public entry. Port 8000 matches
# the existing proxy_pass. See docs/podman-migration.md.
# BIND_HOST=127.0.0.1
# BIND_PORT=8000
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=120

# ─── CORS ───────────────────────────────────────────────────────────────────
# JSON array of allowed origins. Defaults shown below are baked into config.py.
# CORS_ORIGINS=["http://localhost:3000","https://muhanmantle.com"]

# ─── Similarity backend ─────────────────────────────────────────────────────
# fasttext (default) | sentence_transformer
# SIMILARITY_BACKEND=fasttext
#
# When SIMILARITY_BACKEND=sentence_transformer:
# SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional: cpu | cuda | mps
# SENTENCE_TRANSFORMER_DEVICE=cpu
# Optional: BaseWord embedding cache dir (default: models/embedding-cache/).
# In the container that path is /app/models/embedding-cache on the models volume.
# EMBEDDING_CACHE_DIR=/app/models/embedding-cache

# ─── Model file paths (FastText backend only) ───────────────────────────────
# Defaults inside the repo (and inside the container): 
#   models/fasttext/cc.ko.300.vec and models/fasttext/cc.ko.300.kv
# The compose file mounts the host models/ directory at /app/models.
# Do not set these to a host absolute path when running in the container.
# VEC_FILE=/app/models/fasttext/cc.ko.300.vec
# KV_FILE=/app/models/fasttext/cc.ko.300.kv

# ─── Game session cookie (/api/game) ─────────────────────────────────────────
# SESSION_COOKIE_NAME=mm_session
# SESSION_MAX_AGE_SECONDS=2592000
# Set true when the API is served over HTTPS (also enables SameSite=None).
# SESSION_COOKIE_SECURE=false

# ─── Dictionary audit scripts ───────────────────────────────────────────────
# Optional local dictionary path (one word per line, UTF-8)
# KOREAN_DICTIONARY_PATH=/absolute/path/to/korean_dictionary.txt

# ─── Stdict Open API (baseword_dictionary_audit.py) ──────────────────────────
# https://stdict.korean.go.kr/openapi/openApiInfo.do
# STDICT_API_KEY=
